{
  "name": "solid-slider",
  "version": "2.0.0",
  "description": "A slider utility for SolidJS.",
  "author": "David Di Biase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davedbase/solid-slider.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/davedbase/solid-slider/issues"
  },
  "homepage": "https://github.com/davedbase/solid-slider#readme",
  "scripts": {
    "format": "prettier -w \"src/**/*.{js,ts,json,css,tsx,jsx}\"",
    "typecheck": "tsc --noEmit -p .",
    "build": "npm run clean && tsdown && tsc -p tsconfig.solid.json",
    "check:package": "publint && npm_config_dry_run=false attw --pack . --profile esm-only --exclude-entrypoints ./slider.css ./plugins/adaptiveHeight.css ./plugins/adaptiveWidth.css ./package.json",
    "prepublishOnly": "node scripts/check-publish-tag.mjs && npm run typecheck && npm run build && npm run check:package",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/solid/index.jsx",
      "node": {
        "types": "./dist/index.d.ts",
        "default": "./dist/server/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plugins/autoplay": {
      "solid": "./dist/solid/plugins/autoplay.jsx",
      "node": {
        "types": "./dist/plugins/autoplay.d.ts",
        "default": "./dist/server/plugins/autoplay.mjs"
      },
      "default": {
        "types": "./dist/plugins/autoplay.d.ts",
        "default": "./dist/plugins/autoplay.js"
      }
    },
    "./plugins/adaptiveHeight": {
      "solid": "./dist/solid/plugins/adaptiveHeight.jsx",
      "node": {
        "types": "./dist/plugins/adaptiveHeight.d.ts",
        "default": "./dist/server/plugins/adaptiveHeight.mjs"
      },
      "default": {
        "types": "./dist/plugins/adaptiveHeight.d.ts",
        "default": "./dist/plugins/adaptiveHeight.js"
      }
    },
    "./plugins/adaptiveWidth": {
      "solid": "./dist/solid/plugins/adaptiveWidth.jsx",
      "node": {
        "types": "./dist/plugins/adaptiveWidth.d.ts",
        "default": "./dist/server/plugins/adaptiveWidth.mjs"
      },
      "default": {
        "types": "./dist/plugins/adaptiveWidth.d.ts",
        "default": "./dist/plugins/adaptiveWidth.js"
      }
    },
    "./slider.css": "./dist/slider.css",
    "./plugins/adaptiveHeight.css": "./dist/plugins/adaptiveHeight.css",
    "./plugins/adaptiveWidth.css": "./dist/plugins/adaptiveWidth.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "slider",
    "carousel",
    "solid",
    "keen",
    "slider",
    "carousel",
    "caroussel",
    "slideshow",
    "gallery",
    "plugin"
  ],
  "peerDependencies": {
    "@solidjs/web": "^2.0.1",
    "solid-js": "^2.0.1"
  },
  "dependencies": {
    "@solid-primitives/timer": "^1.4.5",
    "@solid-primitives/utils": "^7.0.0",
    "keen-slider": "^6.8.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@solidjs/compiler": "^2.0.1",
    "prettier": "^3.3.3",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  }
}
