{
  "compilerOptions": {
    "outDir": "./dist",
    "emitDeclarationOnly": false,
    "declaration": true,
    "module": "ESNext",
    "target": "ESNext",
    "newLine": "LF",
    "moduleResolution": "bundler",
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "strictNullChecks": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "types": []
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "node_modules"
  ]
}
